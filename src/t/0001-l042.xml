<language id="42">
  <page id="990483" title="Swap Crew" voice="no">
    <t id="1">Swap Crew</t>
    <t id="10">Vyměnit posádku</t>
    <t id="11">Najmout z posádky</t>
    <t id="20">Nahradit</t>
    <t id="21">Nejlepší dostupný</t>
    <t id="23">nebo lepší</t>
    <t id="24">Dostupných: %d</t>
    <t id="25">Na této úrovni není volná servisní posádka</t>
    <t id="26">Nyní:</t>
    <t id="27">Vybere %s na %s %s</t>
    <t id="30">Neobsazený post. Pravým kliknutím najmete z posádky</t>
    <t id="40">Výměna není možná: %s</t>
    <t id="42">Žádná volná servisní posádka</t>
    <t id="43">Probíhá přesun posádky</t>
    <t id="44">Loď plní kritický rozkaz</t>
    <t id="45">Loděnice má ve frontě stavby lodí</t>
    <t id="46">Pro tento post není možné</t>
  </page>
</language>
