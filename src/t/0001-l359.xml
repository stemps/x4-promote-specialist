<language id="359">
  <page id="990483" title="Swap Crew" voice="no">
    <t id="1">Swap Crew</t>
    <t id="10">Смяна на екипаж</t>
    <t id="11">Наемане от екипажа</t>
    <t id="20">Замяна</t>
    <t id="21">Най-добрият наличен</t>
    <t id="23">или по-добре</t>
    <t id="24">Налични: %d</t>
    <t id="25">Няма свободен обслужващ персонал на това ниво</t>
    <t id="26">Сега:</t>
    <t id="27">Избира %s на %s %s</t>
    <t id="30">Свободна длъжност. Десен клик за наемане от екипажа</t>
    <t id="40">Смяната е невъзможна: %s</t>
    <t id="42">Няма свободен обслужващ персонал</t>
    <t id="43">Тече прехвърляне на екипаж</t>
    <t id="44">Корабът изпълнява критична заповед</t>
    <t id="45">Корабостроителницата има поръчки на опашка</t>
    <t id="46">Невъзможно за тази длъжност</t>
  </page>
</language>
